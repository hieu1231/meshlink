<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Round control on the call screen: translucent white, white icon; "checked" = active state. -->
    <style name="Widget.P2p.CallControl" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">26dp</item>
    </style>

    <style name="Widget.P2p.CallCell" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.P2p.CallLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">#E6FFFFFF</item>
    </style>
</resources>
