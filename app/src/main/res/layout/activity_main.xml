<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_grouped">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating capsule tab bar; content scrolls underneath it. -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="300dp"
        android:layout_height="@dimen/tab_bar_height"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_tab_bar"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/tab_mesh"
            style="@style/Widget.P2p.TabItem">

            <ImageView
                style="@style/Widget.P2p.TabIcon"
                android:src="@drawable/ic_tab_mesh" />

            <TextView
                style="@style/Widget.P2p.TabLabel"
                android:text="@string/nav_mesh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_chats"
            style="@style/Widget.P2p.TabItem">

            <ImageView
                style="@style/Widget.P2p.TabIcon"
                android:src="@drawable/ic_tab_chats" />

            <TextView
                style="@style/Widget.P2p.TabLabel"
                android:text="@string/nav_chats" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_board"
            style="@style/Widget.P2p.TabItem">

            <ImageView
                style="@style/Widget.P2p.TabIcon"
                android:src="@drawable/ic_tab_board" />

            <TextView
                style="@style/Widget.P2p.TabLabel"
                android:text="@string/nav_board" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
