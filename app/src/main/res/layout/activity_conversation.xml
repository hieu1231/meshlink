<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_plain"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Top padding is set in code to clear the floating header. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <!-- Encryption notice / empty state, like the system note at the top of a chat. -->
            <TextView
                android:id="@+id/empty_messages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="48dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/fill"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:maxWidth="300dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/label_secondary"
                app:drawableTint="@color/label_secondary"
                app:drawableTopCompat="@drawable/ic_lock"
                tools:text="@string/conversation_empty_dm" />
        </FrameLayout>

        <!-- Composer: round attach · pill field · round mic/send. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_attach"
                style="@style/Widget.P2p.GlassButton"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/attach_media"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/label_secondary" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/composer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:minHeight="44dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/input_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/message_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="2000"
                        android:maxLines="6"
                        android:minHeight="44dp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColorHint="@color/label_secondary" />
                </LinearLayout>

                <!-- Shown while holding the mic: replaces the field. -->
                <LinearLayout
                    android:id="@+id/recording_bar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:id="@+id/recording_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/red" />

                    <TextView
                        android:id="@+id/recording_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="0:07" />

                    <TextView
                        android:id="@+id/recording_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/voice_slide_cancel"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/label_secondary" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_action"
                style="@style/Widget.P2p.GlassButton.Accent"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/voice_hold"
                app:icon="@drawable/ic_mic" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating header over the messages: back · who (tap = find them) · calls. -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_fade"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            style="@style/Widget.P2p.GlassButton"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_chevron_back" />

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_pill"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="44dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textSize="15sp"
                tools:text="Hieu" />

            <TextView
                android:id="@+id/header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="3dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/label_secondary"
                tools:text="Mã hóa đầu-cuối, nối trực tiếp" />
        </LinearLayout>

        <!-- Direct chats: voice and video call in one capsule. -->
        <LinearLayout
            android:id="@+id/call_group"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_pill"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_voice_call"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/call_voice"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="21dp"
                app:iconTint="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_video_call"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/call_video"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_videocam"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="23dp"
                app:iconTint="@color/accent" />
        </LinearLayout>

        <!-- Public channel: its globe avatar instead. -->
        <FrameLayout
            android:id="@+id/header_avatar_box"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/header_avatar"
                style="@style/Widget.P2p.Avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:text="H" />

            <ImageView
                android:id="@+id/header_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_globe"
                android:visibility="gone"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
