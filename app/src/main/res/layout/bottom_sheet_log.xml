<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_margin"
    android:paddingBottom="24dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        style="@style/Widget.P2p.Grabber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="12dp"
        android:accessibilityHeading="true"
        android:text="@string/log_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <com.hieu.p2p.ui.CardLayout
        style="@style/Widget.P2p.Card.Sheet"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_log"
            android:layout_width="match_parent"
            android:layout_height="420dp">

            <TextView
                android:id="@+id/text_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textAppearance="@style/TextAppearance.P2p.Mono"
                android:textIsSelectable="true" />
        </androidx.core.widget.NestedScrollView>
    </com.hieu.p2p.ui.CardLayout>
</LinearLayout>
