<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            style="@style/Widget.P2p.Grabber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/avatar"
                style="@style/Widget.P2p.Avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:textSize="19sp"
                tools:text="H" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    tools:text="Hieu" />

                <TextView
                    android:id="@+id/text_route"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/label_secondary"
                    tools:text="Nối trực tiếp với bạn" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_close"
                style="@style/Widget.P2p.GlassButton.Close"
                android:contentDescription="@string/close"
                app:icon="@drawable/ic_close" />
        </LinearLayout>

        <!-- Precision finding: one big arrow, one big distance, the direction in words. -->
        <com.hieu.p2p.ui.CardLayout
            style="@style/Widget.P2p.Card.Sheet"
            android:layout_marginStart="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="0dp"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <com.hieu.p2p.ui.DirectionArrowView
                android:id="@+id/arrow"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/text_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineLarge"
                android:textSize="46sp"
                tools:text="42 m" />

            <TextView
                android:id="@+id/text_where"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Phía trước, lệch phải, hướng Đông Bắc" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

                <TextView
                    android:id="@+id/badge_accuracy"
                    style="@style/Widget.P2p.Badge"
                    tools:text="sai số ± 8 m" />

                <TextView
                    android:id="@+id/badge_battery"
                    style="@style/Widget.P2p.Badge"
                    tools:text="Pin 64%" />

                <TextView
                    android:id="@+id/badge_seen"
                    style="@style/Widget.P2p.Badge"
                    tools:text="Cập nhật vừa xong" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/text_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/label_secondary"
                tools:text="@string/find_calibrate" />
        </com.hieu.p2p.ui.CardLayout>

        <!-- Path of a probe through the mesh. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/trace_title"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_trace"
                style="@style/Widget.P2p.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trace_button" />
        </LinearLayout>

        <com.hieu.p2p.ui.CardLayout
            style="@style/Widget.P2p.Card.Sheet"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/text_trace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/trace_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/label_secondary" />

            <LinearLayout
                android:id="@+id/trace_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </com.hieu.p2p.ui.CardLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_message"
            style="@style/Widget.P2p.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/board_message_author"
            app:icon="@drawable/ic_tab_chats"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
